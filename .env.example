# Copy to ".env" and fill in (or use the GUI's Email settings, which writes it).
# The installed app keeps this file in %APPDATA%\flight-monitor\.env.
#
# Email account for the reports (Gmail: an App Password, see README).
SMTP_USER=you@gmail.com
# Password: better set it in the GUI (Email settings), which keeps it in Windows
# Credential Manager and removes it from this file. Here it is plain text.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: recipient (defaults to SMTP_USER) and server (defaults to Gmail).
# REPORT_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465            # 465 = SSL, 587 (or other) = STARTTLS
# Older names, still read: GMAIL_USER / GMAIL_APP_PASSWORD

# Optional API keys for the non-Google price engines (see README "Price engines").
# The GUI's "Save as default" writes the selected engine's key here too.
# TRAVELPAYOUTS_TOKEN=     # free:   https://www.travelpayouts.com/  (Profile > API token)
# IGNAV_API_KEY=           # 1,000 free requests: https://ignav.com/signup
# SERPAPI_KEY=             # 250 free searches/month: https://serpapi.com/users/sign_up
